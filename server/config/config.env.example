# The environment to run the application in
NODE_ENV=development

# --- Smart Contract API (contracts/RealEstate.sol, contracts/Escrow.sol) ---
# JSON-RPC endpoint of the chain the contracts are deployed to.
# For local development, run a Hardhat node ("npx hardhat node") which serves this by default.
RPC_URL=http://127.0.0.1:8545

# Private key used ONLY for platform-authorized actions (e.g. minting property NFTs).
# Buyer/seller/inspector/lender actions on Escrow are never signed server-side - see
# server/services/contractService.js. The value below is Hardhat's well-known default
# test account #0 - it holds no real funds. Never reuse it, or any real private key, outside
# of local development, and never commit a real one.
SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (fill in after running your deploy script)
REAL_ESTATE_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ADDRESS=